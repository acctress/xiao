(for (s pre         r   rm)
     ((w "66 F3 "    r16 rm16)
      (l "F3 "       r32 rm32)
      (q "F3 REX.W " r64 rm64))
  (for (op     opc)
       ((popcnt B8)
        (tzcnt  BC)
        (lzcnt  BD))
    (inst ${op}${s}_rm (asm "$op") (ops (w dst $r) (r src $rm)) (enc RM "${pre}0F $opc /r"))))

(inst crc32l_rm8  (asm "crc32") (ops (rw dst r32) (r src rm8))  (enc RM "F2 0F 38 F0 /r"))
(inst crc32l_rm16 (asm "crc32") (ops (rw dst r32) (r src rm16)) (enc RM "66 F2 0F 38 F1 /r"))
(inst crc32l_rm32 (asm "crc32") (ops (rw dst r32) (r src rm32)) (enc RM "F2 0F 38 F1 /r"))
(inst crc32q_rm8  (asm "crc32") (ops (rw dst r64) (r src rm8))  (enc RM "F2 REX.W 0F 38 F0 /r"))
(inst crc32q_rm64 (asm "crc32") (ops (rw dst r64) (r src rm64)) (enc RM "F2 REX.W 0F 38 F1 /r"))

(for (s pre         opc)
     ((b "F3 "       A4)
      (w "66 F3 "    A5)
      (d "F3 "       A5)
      (q "F3 REX.W " A5))
  (inst rep_movs$s
    (asm "rep movs$s")
    (ops (rw rdi r64 (fixed rdi)) (rw rsi r64 (fixed rsi)) (rw rcx r64 (fixed rcx)))
    (enc ZO "${pre}$opc")))

(for (s pre         opc)
     ((b "F3 "       AA)
      (w "66 F3 "    AB)
      (d "F3 "       AB)
      (q "F3 REX.W " AB))
  (inst rep_stos$s
    (asm "rep stos$s")
    (ops (rw rdi r64 (fixed rdi)) (rw rcx r64 (fixed rcx)) (r rax r64 (fixed rax)))
    (enc ZO "${pre}$opc")))

(for (s pre         opc)
     ((b "F2 "       AE)
      (w "66 F2 "    AF)
      (d "F2 "       AF)
      (q "F2 REX.W " AF))
  (inst repne_scas$s
    (asm "repne scas$s")
    (ops (rw rdi r64 (fixed rdi)) (rw rcx r64 (fixed rcx)) (r rax r64 (fixed rax)))
    (enc ZO "${pre}$opc")))
