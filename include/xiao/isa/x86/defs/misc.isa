(for (op      opc)
     ((nop     "90")
      (ret     "C3")
      (leave   "C9")
      (hlt     "F4")
      (int3    "CC")
      (clc     "F8")
      (stc     "F9")
      (cmc     "F5")
      (cld     "FC")
      (pause   "F3 90")
      (ud2     "0F 0B")
      (syscall "0F 05")
      (cpuid   "0F A2")
      (rdtsc   "0F 31"))
  (inst $op (asm "$op") (ops) (enc ZO $opc)))

(inst pushq_r   (asm "push") (ops (r src r64))     (enc O "50+rd"))
(inst popq_r    (asm "pop")  (ops (w dst r64))     (enc O "58+rd"))
(inst pushq_m   (asm "push") (ops (r src rm64))    (enc M "FF /6"))
(inst popq_m    (asm "pop")  (ops (w dst rm64))    (enc M "8F /0"))
(inst pushq_i8  (asm "push") (ops (imm imm8))      (enc I "6A ib"))
(inst pushq_i32 (asm "push") (ops (imm imm32))     (enc I "68 id"))
(inst jmpq_m    (asm "jmp")  (ops (r target rm64)) (enc M "FF /4"))
(inst callq_m   (asm "call") (ops (r target rm64)) (enc M "FF /2"))
