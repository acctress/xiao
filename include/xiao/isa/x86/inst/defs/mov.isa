(for (s pre        rm   r    isz iz)
     ((w "66 "      rm16 r16  16  iw)
      (l ""         rm32 r32  32  id)
      (q "REX.W + " rm64 r64  32  id))

  (inst mov${s}_mr      (asm "mov")     (ops (w dst $rm) (r src $r))                         (enc MR "${pre}89 /r"))
  (inst mov${s}_rm      (asm "mov")     (ops (w dst $r) (r src $rm))                         (enc RM "${pre}8B /r"))
  (inst mov${s}_mi$isz  (asm "mov")     (ops (w dst $rm) (imm imm$isz))                      (enc MI "${pre}C7 /0 $iz"))
  (inst xchg${s}_mr     (asm "xchg")    (ops (rw dst $rm) (rw src $r))                       (enc MR "${pre}87 /r"))
  (inst xadd${s}_mr     (asm "xadd")    (ops (rw dst $rm) (rw src $r))                       (enc MR "${pre}0F C1 /r"))
  (inst cmpxchg${s}_mr  (asm "cmpxchg") (ops (rw dst $rm) (r src $r) (rw acc $r (fixed rax))) (enc MR "${pre}0F B1 /r"))
  (inst cmov${s}_rm     (asm "cmov")    (ops (rw dst $r) (r src $rm) (cond cc))              (enc RM "${pre}0F 40+cc /r"))
  (inst movzx${s}_rm8   (asm "movzx")   (ops (w dst $r) (r src rm8))                         (enc RM "${pre}0F B6 /r"))
  (inst movsx${s}_rm8   (asm "movsx")   (ops (w dst $r) (r src rm8))                         (enc RM "${pre}0F BE /r")))

(for (s pre        r)
     ((l ""         r32)
      (q "REX.W + " r64))
  (inst movzx${s}_rm16 (asm "movzx") (ops (w dst $r) (r src rm16)) (enc RM "${pre}0F B7 /r"))
  (inst movsx${s}_rm16 (asm "movsx") (ops (w dst $r) (r src rm16)) (enc RM "${pre}0F BF /r"))
  (inst bswap${s}_r    (asm "bswap") (ops (rw dst $r))             (enc O "${pre}0F C8+rd")))

(inst movsxdq_rm32 (asm "movsxd") (ops (w dst r64) (r src rm32)) (enc RM "REX.W + 63 /r"))

(inst movw_ri16 (asm "mov")    (ops (w dst r16) (imm imm16)) (enc OI "66 B8+rw iw"))
(inst movl_ri32 (asm "mov")    (ops (w dst r32) (imm imm32)) (enc OI "B8+rd id"))
(inst movq_ri64 (asm "movabs") (ops (w dst r64) (imm imm64)) (enc OI "REX.W + B8+rd io"))

(inst movb_mr      (asm "mov")     (ops (w dst rm8) (r src r8))                          (enc MR "88 /r"))
(inst movb_rm      (asm "mov")     (ops (w dst r8) (r src rm8))                          (enc RM "8A /r"))
(inst movb_mi8     (asm "mov")     (ops (w dst rm8) (imm imm8))                          (enc MI "C6 /0 ib"))
(inst movb_ri8     (asm "mov")     (ops (w dst r8) (imm imm8))                           (enc OI "B0+rb ib"))
(inst xchgb_mr     (asm "xchg")    (ops (rw dst rm8) (rw src r8))                        (enc MR "86 /r"))
(inst xaddb_mr     (asm "xadd")    (ops (rw dst rm8) (rw src r8))                        (enc MR "0F C0 /r"))
(inst cmpxchgb_mr  (asm "cmpxchg") (ops (rw dst rm8) (r src r8) (rw acc r8 (fixed rax))) (enc MR "0F B0 /r"))
(inst setcc_m8     (asm "set")     (ops (w dst rm8) (cond cc))                           (enc M "0F 90+cc /0"))
